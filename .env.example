# Copy to .env and fill in. Never commit .env or your private key.

# "demo" uses Kalshi's demo exchange (fake money). "prod" is real money.
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/home/tradebot/secrets/kalshi.pem

# Safety: the bot never places orders while this is true.
DRY_RUN=true

# Real betting needs BOTH DRY_RUN=false AND a BOT_BANKROLL above 0.
# BOT_BANKROLL is the money the bot may use, in dollars. It never spends more
# than this plus its own winnings, so the rest of your Kalshi balance is left
# alone for your own bets. MAX_LIVE_BETS_PER_DAY caps how many bets it places a day.
BOT_BANKROLL=0
MAX_LIVE_BETS_PER_DAY=5

# Minutes between scan cycles.
LOOP_INTERVAL_MINUTES=5

# Where the SQLite database and logs live.
DATA_DIR=./data
LOG_DIR=./logs

# Caps per scan so each cycle finishes in a few minutes.
MAX_MARKETS_PER_SCAN=5000
MAX_COMBOS_PER_SCAN=2000
MAX_ORDERBOOKS_PER_SCAN=100

# Bet sizing. Bets start at MIN_STAKE to START_MAX_STAKE dollars. The max grows by
# SCALE_FRACTION of lifetime profit, up to MAX_BET_DEFAULT. Above that needs an
# 85%+ win chance and no more than half the profit buffer. Over $500 needs approval.
MIN_STAKE=2
START_MAX_STAKE=5
SCALE_FRACTION=0.10
MAX_BET_DEFAULT=20
HIGH_CONFIDENCE_PROB=0.85
MANUAL_APPROVAL_ABOVE=500

# Only consider bets whose expected profit per $1 (after fees) is at least this.
MIN_EDGE=0.05
COMBOS_TO_EVALUATE=40
MAX_LEG_LOOKUPS=200

# Combos have no listed price. Each cycle the bot asks market makers to quote this
# many combos, reads the replies and withdraws the request. It never accepts a
# quote, so no money moves. Set to 0 to turn off.
RFQ_CHECKS_PER_CYCLE=1

# Combo builder: each cycle the bot builds this many combos of its own from likely
# legs (one per game, tight prices), asks for a quote and paper trades it. Leg counts
# rotate through BUILDER_LEG_COUNTS so the scorecard can compare them. 0 turns it off.
BUILDS_PER_CYCLE=1
BUILDER_COLLECTION=KXMVECROSSCATEGORY-R
BUILDER_LEG_COUNTS=2,3,4,6,8
BUILDER_MIN_LEG_PROB=0.65
BUILDER_MAX_LEG_PROB=0.95
BUILDER_MAX_SPREAD=0.06
# Long-shot builds (underdog legs, big payouts) follow the safe ones in the rotation.
BUILDER_LONGSHOT_LEG_COUNTS=3,4,5
BUILDER_LONGSHOT_MIN_PROB=0.20
BUILDER_LONGSHOT_MAX_PROB=0.50

# Sportsbook second opinion (the-odds-api.com). Leave the key empty to turn it off.
# The free plan has 500 lookups a month: each sport costs 1 lookup per region per
# refresh, so 6 sports every 720 minutes is about 360 a month.
ODDS_API_KEY=
ODDS_SPORTS=basketball_nba,americanfootball_nfl,icehockey_nhl,americanfootball_ncaaf,basketball_ncaab,soccer_epl
ODDS_REGIONS=eu
ODDS_REFRESH_MINUTES=720
# Kalshi game-winner series read in full every scan (matched against sportsbook odds)
KALSHI_GAME_SERIES=KXNBAGAME,KXNFLGAME,KXNHLGAME,KXNCAAFGAME,KXNCAAMBGAME,KXEPLGAME

# Comma-separated ESPN sport/league pairs to collect stats for.
SPORTS_LEAGUES=football/nfl,basketball/nba,hockey/nhl,baseball/mlb,football/college-football,basketball/mens-college-basketball,soccer/eng.1
